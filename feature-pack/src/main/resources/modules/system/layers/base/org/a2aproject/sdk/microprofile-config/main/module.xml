<module xmlns="urn:jboss:module:1.9" name="org.a2aproject.sdk.microprofile-config">

    <properties>
        <property name="jboss.api" value="private"/>
    </properties>

    <resources>
        <artifact name="${org.a2aproject.sdk:a2a-java-sdk-microprofile-config}"/>
    </resources>

    <dependencies>
        <module name="jakarta.enterprise.api"/>
        <module name="jakarta.inject.api"/>

        <module name="org.a2aproject.sdk.server-common"/>
        <module name="org.eclipse.microprofile.config.api"/>
        <!--
            MicroProfileConfigProvider injects the MicroProfile Config object, which SmallRye registers as
            a synthetic bean from its own CDI extension. Weld resolves that bean only from bean archives
            this module can see, so the dependency has to point at the module holding the extension.
        -->
        <module name="io.smallrye.config"/>
        <module name="org.slf4j"/>
    </dependencies>
</module>
