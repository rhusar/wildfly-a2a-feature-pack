<layer-spec xmlns="urn:jboss:galleon:layer-spec:2.0" name="a2a">
    <props>
        <prop name="org.wildfly.category" value="A2A"/>
        <prop name="org.wildfly.description" value="Support for A2A (Agent-to-Agent) Protocol"/>
        <prop name="org.wildfly.stability" value="experimental"/>
        <!-- Packages of the common SDK modules provisioned by this base layer. Glow matches a constant-pool
             entry against the exact class name and then its exact package name, so subpackages have to be
             listed individually. Server- and client-specific packages are declared on a2a-core-server /
             a2a-core-client respectively, so Glow can reach those tiers without dragging in the other side.
             org.a2aproject.sdk.client.http is the exception: the http-client module is a mandatory dependency
             of server-common (server-only provisioning needs it too), so it stays in the base layer and the
             base layer advertises its package. The org.a2aproject.sdk.grpc* packages come from spec-grpc,
             which the base layer provisions for both sides; a deployment touching only those (e.g. the proto
             mappers) is matched here rather than by a transport layer. -->
        <prop name="org.wildfly.rule.class" value="org.a2aproject.sdk.common,org.a2aproject.sdk.util,org.a2aproject.sdk.spec,org.a2aproject.sdk.spec.util,org.a2aproject.sdk.jsonrpc.common.json,org.a2aproject.sdk.jsonrpc.common.wrappers,org.a2aproject.sdk.client.http,org.a2aproject.sdk.grpc,org.a2aproject.sdk.grpc.mapper,org.a2aproject.sdk.grpc.utils"/>
    </props>
    <dependencies>
        <!--
            MicroProfileConfigProvider is the only A2AConfigProvider that lets a deployment override the
            SDK's built-in defaults (a2a.authorization.required, the blocking timeouts, the executor pool
            sizes, ...). Without MicroProfile Config the SDK falls back to the values baked into
            META-INF/a2a-defaults.properties and none of them can be changed.
        -->
        <layer name="microprofile-config"/>
    </dependencies>
    <feature spec="subsystem.a2a"/>
    <packages>
        <!-- Subsystem module -->
        <package name="org.wildfly.extension.a2a"/>
        <package name="org.wildfly.extension.a2a.injection"/>
        <!-- A2A SDK core modules -->
        <package name="org.a2aproject.sdk.common"/>
        <package name="org.a2aproject.sdk.spec"/>
        <package name="org.a2aproject.sdk.spec-grpc"/>
        <package name="org.a2aproject.sdk.jsonrpc-common"/>
        <package name="org.a2aproject.sdk.http-client"/>
        <package name="org.a2aproject.sdk.microprofile-config"/>
        <!-- Third-party dependencies -->
        <!-- For layers that do NOT bring in the GRPC feature-pack with an updated protobuf version -->
        <!-- we need to bring an up-to-date one ourselves, since WildFly uses a very old and incompatible version -->
        <!-- TODO remove once WildFly catches up -->
        <package name="com.google.protobuf"/>
    </packages>
</layer-spec>
