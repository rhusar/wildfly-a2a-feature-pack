<layer-spec xmlns="urn:jboss:galleon:layer-spec:2.0" name="a2a-client-opentelemetry">
    <props>
        <prop name="org.wildfly.category" value="A2A"/>
        <prop name="org.wildfly.description" value="OpenTelemetry tracing and trace-context propagation for the A2A client"/>
        <prop name="org.wildfly.stability" value="experimental"/>
        <!-- Only the client packages. org.a2aproject.sdk.extras.opentelemetry, the shared constants of
             opentelemetry-common, is provisioned by the server layer too, so matching it here would
             resolve a server-side deployment to the client tier. -->
        <prop name="org.wildfly.rule.class" value="org.a2aproject.sdk.extras.opentelemetry.client,org.a2aproject.sdk.extras.opentelemetry.client.propagation"/>
        <prop name="org.wildfly.rule.add-on-depends-on" value="only:a2a"/>
        <prop name="org.wildfly.rule.add-on" value="a2a-opentelemetry,a2a-client-opentelemetry"/>
        <prop name="org.wildfly.rule.add-on-description" value="A2A client emitting an OpenTelemetry span per operation and propagating W3C trace context"/>
    </props>
    <dependencies>
        <layer name="a2a-core-client"/>
        <!--
            The two transport wrappers take the Tracer and the OpenTelemetry instance from the client
            transport config, so the deployment has to get hold of them; microprofile-telemetry is what
            makes them injectable (and pulls in the opentelemetry subsystem that configures the SDK).
        -->
        <layer name="microprofile-telemetry"/>
    </dependencies>
    <packages>
        <package name="org.a2aproject.sdk.opentelemetry-common"/>
        <package name="org.a2aproject.sdk.opentelemetry-client"/>
        <package name="org.a2aproject.sdk.opentelemetry-client-propagation"/>
    </packages>
</layer-spec>
