<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wildfly.a2a</groupId>
        <artifactId>wildfly-a2a-testsuite-integration-parent</artifactId>
        <version>0.0.1.Alpha1-SNAPSHOT</version>
    </parent>

    <artifactId>wildfly-a2a-testsuite-integration-client</artifactId>
    <packaging>jar</packaging>

    <name>WildFly A2A Feature-Pack - Testsuite - Integration - Client</name>

    <!-- The assertions load classes by name from the modules the subsystem adds to the deployment;
         these are here only to compile A2AClientUsage, which feeds the Glow scan. Arquillian,
         ShrinkWrap and JUnit come from the parent. -->
    <dependencies>
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-client-transport-jsonrpc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-client-transport-rest</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-client-transport-grpc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Scans the Arquillian deployment and writes the layers WildFly Glow discovers from it
                 to target/glow-scan/provisioning.xml. Unlike the jsonrpc and rest modules, whose
                 deployments are servers and so discover a2a-core-server too, this one pins that a
                 purely client-side deployment discovers the client tiers and no server layer at all. -->
            <plugin>
                <groupId>org.wildfly.glow</groupId>
                <artifactId>wildfly-glow-arquillian-plugin</artifactId>
                <configuration>
                    <expected-discovery>[a2a-client-grpc, a2a-client-http-json, a2a-client-jsonrpc, a2a-core-client]==>ee-core-profile-server,a2a-client-grpc,a2a-client-http-json,a2a-client-jsonrpc</expected-discovery>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-provisioning</id>
                        <goals>
                            <goal>provision</goal>
                        </goals>
                        <phase>test-compile</phase>
                        <configuration>
                    <feature-packs>
                        <feature-pack>
                            <groupId>org.wildfly</groupId>
                            <artifactId>wildfly-galleon-pack</artifactId>
                            <version>${version.org.wildfly}</version>
                        </feature-pack>
                        <feature-pack>
                            <groupId>${project.groupId}</groupId>
                            <artifactId>wildfly-a2a-feature-pack</artifactId>
                            <version>${project.version}</version>
                        </feature-pack>
                    </feature-packs>
                    <galleon-options>
                        <stability-level>${wildfly.a2a.stability}</stability-level>
                    </galleon-options>
                    <!-- Deliberately no a2a-server-* layer: this is what an application that only talks
                         to a remote agent provisions. Deliberately no grpc layer either, so the optional
                         io.grpc-all dependency of client-transport-grpc is exercised as absent.
                         There is no WildFly Glow scan here - the point of this module is to pin an
                         explicit client-only layer list; Glow discovery is covered by the jsonrpc and
                         rest modules. -->
                    <layers>
                        <layer>ee-core-profile-server</layer>
                        <layer>a2a-client-jsonrpc</layer>
                        <layer>a2a-client-grpc</layer>
                        <layer>a2a-client-http-json</layer>
                            </layers>
                        </configuration>
                    </execution>
                    <!-- Second server, provisioned from the layers Glow discovered above -->
                    <execution>
                        <id>glow-provisioning</id>
                        <goals>
                            <goal>provision</goal>
                        </goals>
                        <phase>test-compile</phase>
                        <configuration>
                            <provisioning-file>${project.build.directory}/glow-scan/provisioning.xml</provisioning-file>
                            <provisioning-dir>${jboss.home.glow}</provisioning-dir>
                            <galleon-options>
                                <stability-level>${wildfly.a2a.stability}</stability-level>
                            </galleon-options>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <!-- Runs the same assertions a second time against the Glow-provisioned server, so
                         the discovered layer set is shown to produce a working client-only server, not
                         merely to match. -->
                    <execution>
                        <id>glow.surefire</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables combine.children="override">
                                <jboss.dist>${jboss.home.glow}</jboss.dist>
                                <jboss.install.dir>${jboss.home.glow}</jboss.install.dir>
                                <!-- combine.children="override" drops the inherited value, so redeclare
                                     it here to keep the agent card port and (under -Dcoverage) instrument
                                     the Glow-provisioned server JVM too. -->
                                <server.jvm.args>-Dtest.agent.card.port=8080 ${jacoco.server.argLine}</server.jvm.args>
                                <jboss.args>${server.jboss.args}</jboss.args>
                            </systemPropertyVariables>
                            <reportNameSuffix>glow</reportNameSuffix>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
