<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wildfly.a2a</groupId>
        <artifactId>wildfly-a2a-testsuite-integration-parent</artifactId>
        <version>0.0.1.Alpha1-SNAPSHOT</version>
    </parent>

    <artifactId>wildfly-a2a-testsuite-integration-opentelemetry</artifactId>
    <packaging>jar</packaging>

    <name>WildFly A2A Feature-Pack - Testsuite - Integration - OpenTelemetry</name>

    <dependencies>
        <!-- A2A SDK client, used by the test JVM to drive the agent over JSON-RPC -->
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-client-transport-spi</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-client-transport-jsonrpc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- No WildFly Glow scan here. a2a-server-opentelemetry carries no org.wildfly.rule.class -
                 its decorator is enabled by @Priority and referenced by nothing in a deployment - so
                 there is no discovery to pin; the layer is an add-on. -->
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-provisioning</id>
                        <goals>
                            <goal>provision</goal>
                        </goals>
                        <phase>test-compile</phase>
                        <configuration>
                            <feature-packs>
                                <feature-pack>
                                    <groupId>org.wildfly</groupId>
                                    <artifactId>wildfly-galleon-pack</artifactId>
                                    <version>${version.org.wildfly}</version>
                                </feature-pack>
                                <feature-pack>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>wildfly-a2a-feature-pack</artifactId>
                                    <version>${project.version}</version>
                                </feature-pack>
                            </feature-packs>
                            <galleon-options>
                                <stability-level>${wildfly.a2a.stability}</stability-level>
                            </galleon-options>
                            <!-- microprofile-telemetry is not listed: both a2a-*-opentelemetry layers
                                 depend on it, so provisioning them has to bring it in. -->
                            <layers>
                                <layer>ee-core-profile-server</layer>
                                <layer>jaxrs</layer>
                                <layer>a2a-server-jsonrpc</layer>
                                <layer>a2a-server-opentelemetry</layer>
                                <layer>a2a-client-jsonrpc</layer>
                                <layer>a2a-client-opentelemetry</layer>
                            </layers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
